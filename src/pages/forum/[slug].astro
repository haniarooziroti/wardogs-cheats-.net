---
import '../../styles/forum.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/icons/Icon.astro';
import { editorialNotes, forumPosts, getForumPost } from '../../data/forum';
import { breadcrumbSchema, webPageSchema } from '../../utils/schema';

export function getStaticPaths() {
  return forumPosts.map((post) => ({ params: { slug: post.slug } }));
}

const post = getForumPost(Astro.params.slug!);
if (!post) return Astro.redirect('/forum/');
const path = `/forum/${post.slug}/`;
const title = post.title;
const description = post.excerpt;
const notes = editorialNotes(post);
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Editorial notes', path: '/forum/' },
  { name: post.title, path },
];
const relatedPosts = [
  ...forumPosts.filter((item) => item.slug !== post.slug && item.category === post.category),
  ...forumPosts.filter((item) => item.slug !== post.slug && item.category !== post.category),
].slice(0, 3);
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
  robots="noindex, follow"
  jsonLd={[
    webPageSchema({ name: title, description, url: path }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="forum-page py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="forum-layout forum-layout--detail">
        <main class="forum-main">
          <article class="forum-detail-card">
            <div class="forum-detail-content">
              <div class="forum-post-meta">
                <span class={`forum-community-avatar tone-${post.categoryTone}`}><Icon name="users" size={15} /></span>
                <a href="/forum/" class="forum-community-name">{post.category}</a>
                <span>·</span><span>Editorial discussion</span>
              </div>
              <h1>{post.title}</h1>
              <p class="forum-detail-kicker">
                Staff-written notes, not a live thread. There are no user accounts, votes, or reply counts on these pages.
              </p>
              <div class="forum-detail-copy">{post.body.map((paragraph) => <p>{paragraph}</p>)}</div>
              {
                post.sourceTitle && (
                  <p class="forum-source forum-source--detail">
                    Related article:{' '}
                    <a href={post.sourcePath}>{post.sourceTitle}</a>
                  </p>
                )
              }
              {
                notes.length > 0 && (
                  <section class="forum-comments" aria-labelledby="notes-title">
                    <div class="forum-comments__heading">
                      <h2 id="notes-title">Editorial notes</h2>
                    </div>
                    {notes.map((note) => (
                      <article class="forum-comment">
                        <div class="forum-comment__body">
                          <p>{note}</p>
                        </div>
                      </article>
                    ))}
                  </section>
                )
              }
            </div>
          </article>
        </main>
        <aside class="forum-sidebar">
          <section class="forum-side-card forum-about">
            <div class="forum-about__content">
              <h2>{post.category}</h2>
              <p>Editorial notes grouped by topic for easier reading next to Wardogs cheat articles.</p>
              <a class="forum-join" href="/forum/">Back to editorial notes</a>
            </div>
          </section>
          <section class="forum-side-card forum-related-card" aria-labelledby="forum-related-title">
            <h2 class="forum-side-heading" id="forum-related-title">More notes</h2>
            <ul class="forum-related-list">
              {
                relatedPosts.map((item) => (
                  <li>
                    <a href={`/forum/${item.slug}/`}>
                      <span class="forum-related-list__category">{item.category}</span>
                      <b>{item.title}</b>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a class="forum-related-card__all" href="/forum/">View all editorial notes <Icon name="arrowRight" size={14} /></a>
          </section>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
