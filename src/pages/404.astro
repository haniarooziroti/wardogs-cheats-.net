---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import Icon from '../components/icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { ROUTES } from '../utils/path';

---

<BaseLayout
  title="This Wardogs cheats page was not found on this site"
  description="That Wardogs cheats URL is missing or moved. Open the homepage overview or the Lite, Pro, and Elite catalog to continue from a working page."
  noindex={true}
>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-lg px-5 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">404</p>
      <h1 class="mt-3 text-3xl font-bold uppercase md:text-4xl">This Wardogs cheats page was not found on this site</h1>
      <p class="mt-4 text-muted-foreground">
        That URL does not exist or may have moved. Head back to the homepage or browse cheat tiers and products.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <Button as="a" href={ROUTES.home} variant="primary">
          Back to the Wardogs cheats overview
          <Icon name="arrowRight" size={17} />
        </Button>
        <Button as="a" href={ROUTES.products} variant="outline">Open the Wardogs catalog</Button>
        <Button as="a" href={ROUTES.productsElite} variant="outline">Open Wardogs Elite details</Button>
      </div>
    </div>
  </section>
</BaseLayout>
