---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  titleId?: string;
  /** Use h1 only once per page (typically the page hero). Section titles default to h2 for IA/SEO. */
  titleTag?: 'h1' | 'h2' | 'h3';
  centered?: boolean;
  wide?: boolean;
}

const { eyebrow, title, desc, titleId, titleTag = 'h2', centered = false, wide = false } = Astro.props;
const Heading = titleTag;
---

<header
  class:list={[
    'section-header space-y-0',
    wide && 'section-header--wide',
    centered && 'mx-auto text-center',
  ]}
>
  <p class="section-header__eyebrow">{eyebrow}</p>
  <Heading id={titleId} class="section-header__title">{title}</Heading>
  {desc ? <p class="section-header__subtitle">{desc}</p> : null}
</header>
