---
import { canonicalUrl } from '../config/seo';

interface Props {
  title: string;
  path?: string;
  class?: string;
}

const { title, path, class: className } = Astro.props;
const url = canonicalUrl(path ?? Astro.url.pathname);
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const networks = [
  {
    name: 'X',
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
    label: `Share ${title} on X`,
    path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    name: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    label: `Share ${title} on Facebook`,
    path: 'M13 10.5V8.25c0-.69.56-1.25 1.25-1.25H16V4h-1.75A4.25 4.25 0 0 0 10 8.25V10.5H7.5V14H10v8h3v-8h2.25L16 10.5h-3z',
  },
  {
    name: 'Telegram',
    href: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`,
    label: `Share ${title} on Telegram`,
    path: 'M21.8 4.3 18.4 20.2c-.26 1.15-1.04 1.43-2.1.89l-5.82-4.29-2.81 2.7c-.31.31-.57.57-1.17.57l.42-5.95 10.83-9.78c.47-.42-.1-.65-.73-.24L5.3 12.7 0 11.03c-1.15-.36-1.17-1.15.24-1.7L20.3 3.2c.96-.36 1.8.22 1.5 1.1z',
  },
  {
    name: 'Reddit',
    href: `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`,
    label: `Share ${title} on Reddit`,
    path: 'M14.5 3.2c.4.9 1.4 1.5 2.5 1.5a2.7 2.7 0 1 0 0-5.4 2.7 2.7 0 0 0-2.4 1.5L12 1.6 9.4.8A2.7 2.7 0 1 0 7 2.3c1.1 0 2.1.6 2.5 1.5l2.5.8 2.5-1.4zM6.8 10.2a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6zm10.4 0a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6zM7.3 16.4a6.3 6.3 0 0 0 9.4 0 .9.9 0 0 0-1.3-1.2 4.5 4.5 0 0 1-6.8 0 .9.9 0 1 0-1.3 1.2z',
  },
  {
    name: 'WhatsApp',
    href: `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`,
    label: `Share ${title} on WhatsApp`,
    path: 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.8 14.2c-.2.7-1.3 1.2-1.8 1.3-.5.1-1 .2-1.7-.1-.4-.2-.9-.3-1.5-.6-2.7-1.2-4.5-4-4.6-4.2-.2-.2-1.3-1.7-1.3-3.2 0-1.5.8-2.3 1.1-2.6.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5.2.6.7 2 .8 2.1.1.2.1.3 0 .5l-.3.5c-.1.2-.3.4-.1.7.1.3.6 1.1 1.4 1.8.9.8 1.7 1.1 2 .1.2-.2.5-.7.7-.9.2-.2.4-.2.6-.1l2 .9c.2.1.4.2.4.3.1.5-.1 1.3-.3 2z',
  },
] as const;
---

<nav class:list={['share-buttons mt-10 flex flex-wrap items-center gap-2', className]} aria-label="Share this page">
  <p class="w-full text-xs font-semibold uppercase tracking-wider text-muted-foreground">Share</p>
  {
    networks.map((network) => (
      <a
        href={network.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={network.label}
        class="inline-flex size-10 items-center justify-center rounded-full border border-border bg-card text-foreground transition-colors hover:border-primary hover:text-primary"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d={network.path} />
        </svg>
      </a>
    ))
  }
</nav>
