---
import {
  DEFAULT_IMAGE_WIDTHS,
  defaultWebpSrc,
  responsiveSrcSet,
} from '../utils/responsiveImage';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: 'lazy' | 'eager';
  fetchPriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  widths?: readonly number[];
  class?: string;
  desktopOnly?: boolean;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchPriority,
  sizes = '(min-width: 1024px) 640px, 100vw',
  widths = DEFAULT_IMAGE_WIDTHS,
  class: className,
  desktopOnly = false,
} = Astro.props;

const placeholderPixel =
  'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';

const isHttp = /^https?:\/\//i.test(src);
const isRaster = isHttp || /\.(png|jpe?g|webp)$/i.test(src);
const srcSet = isHttp ? undefined : responsiveSrcSet(src, widths);
const imgSrc = isHttp
  ? src
  : desktopOnly
    ? placeholderPixel
    : defaultWebpSrc(src, widths);
const pictureSizes = desktopOnly ? '(min-width: 1024px) 490px, 1px' : sizes;
const pictureMedia = desktopOnly ? '(min-width: 1024px)' : undefined;
---

{
  isRaster && !isHttp ? (
    <picture>
      <source type="image/webp" srcset={srcSet} sizes={pictureSizes} media={pictureMedia} />
      <img
        src={imgSrc}
        srcset={desktopOnly ? undefined : srcSet}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding="async"
        fetchpriority={fetchPriority}
        sizes={pictureSizes}
        class={className}
      />
    </picture>
  ) : isHttp ? (
    desktopOnly ? (
      <picture>
        <source srcset={src} media="(min-width: 1024px)" sizes="490px" />
        <img
          src={placeholderPixel}
          alt={alt}
          width={width}
          height={height}
          loading={loading}
          decoding="async"
          fetchpriority={fetchPriority}
          sizes={pictureSizes}
          class={className}
        />
      </picture>
    ) : (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding="async"
        fetchpriority={fetchPriority}
        sizes={sizes}
        class={className}
      />
    )
  ) : (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      fetchpriority={fetchPriority}
      class={className}
    />
  )
}
